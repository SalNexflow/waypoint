# Copy to .env before running `docker compose up`.
# .env is gitignored; .env.example is committed.

POSTGRES_USER=waypoint
POSTGRES_PASSWORD=waypoint_dev_only
POSTGRES_DB=waypoint

# Host/port here are the compose service name and internal port,
# which is what the api container needs. To run alembic from Windows
# instead, override with localhost:5432.
DATABASE_URL=postgresql+asyncpg://waypoint:waypoint_dev_only@db:5432/waypoint

# Local timezone for the dispatch day. Malaysia is UTC+8, no DST.
TIMEZONE=Asia/Kuala_Lumpur

LOG_LEVEL=INFO

# --- Browser origins allowed to call the API (field phase 2) ---
# Comma-separated, no spaces. The dispatcher console is 3000, the technician
# PWA is 3002. A phone on the LAN is a THIRD origin -- it reaches the API at
# this machine's address, not localhost -- so add it here before testing on a
# real device, e.g. ...,http://192.168.1.42:3002
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3002,http://127.0.0.1:3002

# How long a dispatcher-issued technician access code stays redeemable.
ACCESS_CODE_TTL_HOURS=24

# --- Dispatcher console access (field phase 10) ---
# A shared secret every dispatcher-side route requires as a bearer token.
# Leave empty for localhost-only development. It becomes MANDATORY the moment
# CORS_ORIGINS trusts a non-local origin -- the API answers 503 rather than
# serve an open console to a network.
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
DISPATCH_TOKEN=

# --- Routing (phase 3) ---
# auto = prefer OSRM, fall back to haversine with a loud warning.
# osrm = require OSRM. haversine = never touch the network.
ROUTING_PROVIDER=auto
OSRM_URL=http://osrm:5000

# --- LLM for natural-language dispatch (phase 13) ---
# deepseek (needs a key) or ollama (local, no key)
LLM_PROVIDER=deepseek
# https://platform.deepseek.com -> API keys. DeepSeek's API is OpenAI-compatible,
# so this is used with the openai client pointed at api.deepseek.com.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# Used when LLM_PROVIDER=ollama. host.docker.internal reaches the host's
# Ollama from inside the api container on Docker Desktop.
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1

# CP-SAT search workers for request-triggered solves. Each worker holds a full
# copy of the search state: on an 80-job day, 4 workers peak at ~750MB and 8 at
# ~1.6GB for the same result quality. Raise only if this container has the RAM.
SOLVER_WORKERS=4
